<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Blog' ,
        description: 'Blog posts by Hugo Ruiz-Mireles on CS, research, competitive programming, and career development.' })
    %>
</head>

<body>
    <%- include('partials/nav') %>

    <div class="container py-5">
        <h1 class="mb-4">Blog</h1>

        <% if (posts.length===0) { %>
            <p class="text-muted">No posts yet — check back soon.</p>
            <% } else { %>
                <div class="row g-4">
                    <% posts.forEach(post=> { %>
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title"><a href="/blog/<%= post.slug %>"
                                            class="text-dark text-decoration-none">
                                            <%= post.title %>
                                        </a></h5>
                                    <p class="card-text text-muted small">
                                        <%= post.date %>
                                    </p>
                                    <% if (post.description) { %>
                                        <p class="card-text">
                                            <%= post.description %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>
</body>

</html>